{
  "manifest_version": 3,
  "name": "Netflix Auto Skip Intro & Recap",
  "version": "1.1.0",
  "description": "Automatically skips recap and intro segments on Netflix.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["route-watch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
